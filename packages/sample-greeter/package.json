{
  "name": "@zhengzhuangpro/dsh-sample-greeter",
  "version": "0.1.0",
  "description": "DSH Web 示例插件：展示客户端插件的标准写法——i18n、sidebar.footer.action 与 conversation.composer.dock 双 Slot 注册、CSS 注入与实时时钟。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node ../../scripts/build-client.mjs sample-greeter",
    "bundle:watch": "node ../../scripts/build-client.mjs sample-greeter --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.7.0"
  }
}
