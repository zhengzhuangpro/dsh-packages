{
  "name": "@zhengzhuangpro/dsh-hotnews",
  "version": "0.0.2-beta.3",
  "description": "DSH Web 插件：在 DeepSeek Harness 浏览器界面内查看 hotnews 聚合的热门新闻（百度/微博/抖音/虎扑/知乎/掘金/36氪/GitHub/少数派/V2EX/华尔街见闻）。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "plugin",
    "news",
    "hotnews",
    "trending"
  ],
  "author": "zhengzhuang <zhengzhuangpro@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhengzhuangpro/hotnews.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node ../../scripts/build-client.mjs @zhengzhuangpro/dsh-hotnews",
    "bundle:watch": "node ../../scripts/build-client.mjs @zhengzhuangpro/dsh-hotnews --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run bundle"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "hotnews": "^0.1.7",
    "react": "^18.2.0",
    "typescript": "^5.7.0"
  }
}
